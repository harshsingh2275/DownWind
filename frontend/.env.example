# Frontend environment configuration
# Required: Public API base URL (no trailing slash).
# Set this in your Amplify Console environment variables (see docs/manual-actions.md M-13).
VITE_API_BASE_URL=https://placeholder-api-id.execute-api.ap-south-1.amazonaws.com/prod

# Optional: Override map tile URL (default: OpenStreetMap standard tiles).
# Switch to Carto Positron or Protomaps if traffic exceeds OSM policy limits (Q-07/TD-002).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional: Override map tile attribution HTML (rendered in Leaflet attribution control).
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
